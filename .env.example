# Copy to `.env.local` or adjust `.env.development` / `.env.production`.

# AI Tutor (requires local Ollama when provider is ollama)
# - Development (`npm run dev`): defaults ON unless set to false
# - Production builds (`npm run build`): defaults OFF unless set to true
VITE_ENABLE_AI_TUTOR=false
VITE_AI_PROVIDER=ollama
VITE_OLLAMA_URL=http://localhost:11434/api/chat
VITE_OLLAMA_MODEL=llama3.1

# Static hosting (GitHub Pages): use HashRouter so refreshes on deep links work
# without a SPA rewrite. Set to true in `.env.production` for deployment.
VITE_USE_HASH_ROUTER=false
